{
  "devtools": {
    "transport": {
      "type": "stdio",
      "command": "mcp-devtools",
      "env": {
        "ENABLE_ADDITIONAL_TOOLS": "sequential_thinking,gemini-agent,codex-agent"
      }
    },
    "secrets": {},
    "surfaces": ["claude", "vscode", "cloud", "codex"],
    "default_for": ["*"]
  },
  "rea": {
    "transport": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "rea-agents@6.7.0", "mcp"]
    },
    "secrets": {},
    "surfaces": ["claude", "vscode", "codex"],
    "default_for": []
  },
  "svelte": {
    "transport": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@sveltejs/mcp"]
    },
    "secrets": {},
    "surfaces": ["claude", "vscode", "cloud", "codex"],
    "default_for": ["svelte.config.js"]
  },
  "github": {
    "codex_enabled": false,
    "transport": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "secrets": {
      "AUTH_TOKEN": {
        "header": "Authorization",
        "description": "GitHub MCP Authorization header: enter 'Bearer <PAT>' - the 'Bearer ' prefix is required"
      }
    },
    "surfaces": ["claude", "vscode", "cloud", "codex"],
    "default_for": []
  },
  "transit": {
    "codex_enabled": false,
    "_comment": "Transit.app built-in MCP server; enable in Settings (default port 3141). Localhost only, so no cloud surface.",
    "transport": {
      "type": "http",
      "url": "http://localhost:3141/mcp"
    },
    "secrets": {},
    "surfaces": ["claude", "vscode", "codex"],
    "default_for": []
  },
  "azure": {
    "transport": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    },
    "secrets": {},
    "surfaces": ["claude", "vscode", "cloud", "codex"],
    "default_for": []
  },
  "terraform": {
    "codex_enabled": false,
    "transport": {
      "type": "stdio",
      "command": "podman",
      "args": ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:latest"]
    },
    "secrets": {},
    "surfaces": ["claude", "vscode", "cloud", "codex"],
    "default_for": []
  }
}
